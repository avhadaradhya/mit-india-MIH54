# KrushakSetu Environment Variables
# Copy this file to .env and fill in real values

# Weather (OWM key is exposed to frontend via VITE_ prefix - this is intentional)
VITE_OWM_KEY=__REPLACE_WITH_OWM_KEY__

# LLM Reasoning (server-side only - never prefix with VITE_)
GROQ_API_KEY=__REPLACE_WITH_GROQ_KEY__
CEREBRAS_API_KEY=__REPLACE_WITH_CEREBRAS_KEY__

# WhatsApp Alerts (server-side only)
TWILIO_ACCOUNT_SID=__REPLACE__
TWILIO_AUTH_TOKEN=__REPLACE__
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Backend
DATABASE_PATH=./data/krushaksetu.duckdb
